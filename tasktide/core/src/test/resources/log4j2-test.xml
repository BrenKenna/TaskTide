<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Appenders>
        
        <!-- Console Appender -->
        <Console name="STDOUT" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p [ %t -> %C.%M ]: %m%n"/>
        </Console>

        <!-- File Appender -->
        <File name="LOGFILE" fileName="logs/test/core/TestLog-Core.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p [ %t -> %C.%M ]: %m%n"/>
        </File>
    </Appenders>

    <Loggers>
        
        <!-- Logger for specific package/class -->
        <Logger name="org.tasktide" level="DEBUG" additivity="false">
            <AppenderRef ref="STDOUT"/>
            <AppenderRef ref="LOGFILE"/>
        </Logger>
        
        <!-- Disable mutex logs -->
        <Logger name="org.tasktide.mutex" level="off" additivity="false"/>
        
        <logger name="org.eclipse.jnosql.databases.mongodb" level="DEBUG"/>

        <!-- Root Logger -->
        <Root level="INFO">
            <AppenderRef ref="STDOUT"/>
            <AppenderRef ref="LOGFILE"/>
        </Root>
    </Loggers>
</Configuration>